---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";

const homeEntry = await getEntry("pages", "home");
if (!homeEntry) {
  throw new Error("Home content entry not found!");
}
const data = homeEntry.data;
const heroImage =
  data.carousel && data.carousel.length > 0
    ? data.carousel[0].image
    : "/images/default-image.jpg";
---

<Layout title="LaEventers - Premium Event Planning">
  <section class="hero-section">
    <div class="hero-bg">
      <img src={heroImage} alt="Event Background" />
    </div>
    <div class="container hero-content animate-fade-in-up">
      <span class="hero-badge">Est. 2026</span>
      <h1 class="hero-title">
        {data.intro_title.split(" & ")[0]} &amp; <br />
        <span class="highlight"
          >{data.intro_title.split(" & ")[1] || "Beyond"}
        </span>
      </h1>
      <p class="hero-subtitle delay-100 animate-fade-in-up">
        {data.intro_description}
      </p>
      <a href="/contact" class="button delay-200 animate-fade-in-up"
        >Plan Your Dream Event</a
      >
    </div>
  </section>

  <section class="image-grid">
    {
      data.carousel &&
        data.carousel.slice(0, 3).map((item: any, index: number) => (
          <div class={`image-cell cell-${index + 1}`}>
            <img src={item.image} alt={item.title} loading="lazy" />
          </div>
        ))
    }
  </section>

  <section class="features-section">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title">Our Services</h2>
        <p>
          From conceptualization to execution, we deliver an unforgettable
          experience.
        </p>
      </header>
      <div class="grid">
        {
          data.features &&
            data.features.map((feature: any) => (
              <div class="glass-card">
                <div class="icon-wrapper" set:html={feature.icon_svg} />
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </div>
            ))
        }
      </div>
    </div>
  </section>

  <section class="locations-section" style="padding: 6rem 0; background: var(--bg-alternate);">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title">Visit Us</h2>
        <p>Come meet us in person at our primary office or our newly opened branch.</p>
      </header>
      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
        <div class="glass-card location-card" style="padding: 2rem;">
          <h3>Head Office</h3>
          <p style="margin-bottom: 1.5rem; color: var(--text-muted);">123 Event Planner Blvd, Paris</p>
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2624.9916256937595!2d2.2922926156743895!3d48.85837007928746!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e66e2964e34e2d%3A0x8ddca9ee380ef7e0!2sEiffel%20Tower!5e0!3m2!1sen!2sus!4v1611145620984!5m2!1sen!2sus" 
            width="100%" 
            height="250" 
            style="border:0; border-radius: var(--radius-md);" 
            allowfullscreen="" 
            loading="lazy">
          </iframe>
        </div>
        <div class="glass-card location-card" style="padding: 2rem;">
          <h3>Branch Office</h3>
          <p style="margin-bottom: 1.5rem; color: var(--text-muted);">456 Celebration Ave, London</p>
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2483.546342813596!2d-0.12196608422998632!3d51.50394397963365!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x487604b900d26973%3A0x4291f3172409ea92!2sLondon%20Eye!5e0!3m2!1sen!2sus!4v1611145710283!5m2!1sen!2sus" 
            width="100%" 
            height="250" 
            style="border:0; border-radius: var(--radius-md);" 
            allowfullscreen="" 
            loading="lazy">
          </iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>
